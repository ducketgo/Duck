# DUCK Platform - Environment Variables
# Copy this file to .env.local and fill in your values

# ===========================================
# SUPABASE - Main Platform Database
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ===========================================
# DUCKAUTH - Firebase Authentication
# ===========================================
# Firebase Web App config is public client configuration, not a service credential.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=duckauth2026.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=duckauth2026
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://duckauth2026-default-rtdb.asia-southeast1.firebasedatabase.app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=duckauth2026.firebasestorage.app
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=asia-southeast1

# ===========================================
# APPLICATION
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=DUCK
# Empty for a user/organization site (https://duck.github.io).
# Use "/repository-name" for a GitHub Pages project site.
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_DUCK_REGISTRATION_ENABLED=false
NEXT_PUBLIC_GUEST_TRANSFER_ENABLED=false
NEXT_PUBLIC_FIREBASE_SUPABASE_BRIDGE_ENABLED=false
# Public-facing metadata; fill before launch.
NEXT_PUBLIC_HOSTING_PROVIDER=
# Record the Supabase database region after selecting it.
NEXT_PUBLIC_SUPABASE_REGION=

# ===========================================
# ADMIN
# ===========================================
# Admin user email (founder)
ADMIN_EMAIL=duckdev-service@protonmail.com

# Set only as Supabase Edge Function secrets, never as NEXT_PUBLIC variables.
# DUCK_APP_ORIGIN=https://your-duck-domain.example
# GUEST_TRANSFER_IP_HASH_SECRET=generate-a-random-secret-of-at-least-32-bytes
# GUEST_TRANSFER_CLEANUP_SECRET=generate-another-random-secret
