{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        "preferences": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['theme', 'language'])",
          "theme": {
            ".validate": "newData.isString() && (newData.val() === 'dark' || newData.val() === 'light' || newData.val() === 'system')"
          },
          "language": {
            ".validate": "newData.isString() && (newData.val() === 'fr' || newData.val() === 'en')"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
